==============================================================EXISTS KEYWORD
EXISTS  used to filter rows where a related record exists
NOT EXISTS  used to filter rows where a related record does not exist
both are used for safety matter not necessary but it is a good practice to use them

-- EXISTS
Checks if a subquery returns at least one row.
If TRUE, the outer query executes.
Example:
SELECT student_id, first_name
FROM student s
WHERE EXISTS (
    SELECT 1
    FROM enrollment e
    WHERE e.student_id = s.student_id
);
-- Returns students who have at least one enrollment record.
DROP DATABASE IF EXISTS school_db;

-- NOT EXISTS
Checks if a subquery returns no rows.
If TRUE, the outer query executes.
Example:
SELECT student_id, first_name
FROM student s
WHERE NOT EXISTS (
    SELECT 1
    FROM enrollment e
    WHERE e.student_id = s.student_id
);
-- Returns students who have no enrollment record.
CREATE DATABASE IF NOT EXISTS school_db;



=================================================================INSERT COMMAND
INSERT COMMAND IS USED TO INSERT VALUE INTO THE TABLE
TWO WAYS TO INSERT
1. Single row → insert one complete record.
2. Specific columns → insert into chosen columns only.
3. Multiple rows → insert many records in one go.
example

-- 1. Insert a single row (all columns)
Syntax:
INSERT INTO table_name VALUES (value1, value2, value3, ...);
Example:
INSERT INTO student VALUES (1, 'Rahul', 20, 'A');

-- 2. Insert a single row into specific columns
Syntax:
INSERT INTO table_name (col1, col2, col3) VALUES (value1, value2, value3);
Example:
INSERT INTO student (student_id, name, grade) VALUES (2, 'Priya', 'B');

-- 3. Insert multiple rows at once
Syntax:
INSERT INTO table_name (col1, col2, col3, ...) VALUES
(value1, value2, value3, ...),
(value1, value2, value3, ...),
(value1, value2, value3, ...);
Example:
INSERT INTO student (student_id, name, age, grade) VALUES
(3, 'Nikesh', 22, 'A+'),
(4, 'Anita', 21, 'B+'),
(5, 'Ravi', 23, 'A');

